# =============================================================================
# .gitignore für ProfiPrompt
# Basiert auf .gitignore-template (Software Entwicklung)
# =============================================================================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.eggs/
dist/
build/

# ---- Virtuelle Umgebungen ----
venv/
.venv/
env/
.env/

# ---- Interne Steuerungsdateien (NIEMALS in Git!) ----
AUFGABEN.txt
TEST.txt
TESTS.txt
TESTERGEBNISSE.txt
BUGREPORT.md
DIAGNOSE_REPORT.md
LOCK.txt
LOCK.*.txt
LOCK*.txt
LOCK.*
*.lock

# ---- Persönliche / sensible Daten ----
_USER/
.env
.env.*
credentials.json
client_secret*.json
token.json
secrets.*
*.pem
*.key
*.pfx
*.p12
*.cer
*.crt
keyring/

# ---- Build-Artefakte & Releases ----
releases/*
!releases/windowsstore/
releases/windowsstore/*
!releases/windowsstore/BUILD.md
!releases/windowsstore/WACK_PROTOCOL.md
!releases/windowsstore/store_listing_de.md
!releases/windowsstore/store_listing_en.md
!releases/windowsstore/store_settings.json
!releases/windowsstore/SUBMISSION-SHEET.md
!releases/windowsstore/test_reports/
releases/windowsstore/test_reports/*
!releases/windowsstore/test_reports/README.md
!releases/windowsstore/test_reports/*.md
*.exe
*.msi
*.msix
*.appx
_WARTUNG/msix_staging/
store_package/

# ---- IDE & Editoren ----
.claude/
.vscode/
.idea/
*.swp
*.swo
*~

# ---- Betriebssystem ----
desktop.ini
Thumbs.db
.DS_Store
ehthumbs.db

# ---- Pytest ----
.pytest_cache/

# ---- Projektspezifisch ----
.prompt_manager/
prompts.json
boards.json
*.tmp
*.db
*.log
*.bak
DECISIONS.md
PORTIERUNGSPLAN.md
TODO.md
DONE.md
build_exe.bat
docs/superpowers/

# ---- Multi-Host-Synchronisation & Konfliktschutz ----
*.sync-conflict-*
*.conflict
*-CONFLIT-*
*-conflict-*
*-WORKSTATION-LG*
*-ASUS-GEI*

# ---- Web-Companion / Node Test Caches ----
node_modules/
coverage/
.nyc_output/
